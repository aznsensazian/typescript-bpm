generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  avatar       String?
  department   String?
  jobTitle     String?
  isActive     Boolean  @default(true)
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles                UserRole[]
  processesCreated     Process[]
  processVersions      ProcessVersion[]
  comments             Comment[]
  approvals            GovernanceApproval[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  governanceInstances  GovernanceInstance[]
  collaborations       ProcessCollaborator[]
  publications         Publication[]
  publicationFeedbacks PublicationFeedback[]
  foldersCreated       Folder[]
  dictionaryEntries    DictionaryEntry[]
  governanceWorkflows  GovernanceWorkflow[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─── Process Management ──────────────────────────────────────────────────────

model Process {
  id             String    @id @default(uuid())
  name           String
  description    String?
  category       String?
  status         String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED, UNDER_REVIEW
  bpmnXml        String?
  svgThumbnail   String?
  currentVersion Int       @default(1)
  folderId       String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?
  tags           String?

  folder              Folder?               @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy           User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  versions            ProcessVersion[]
  comments            Comment[]
  collaborators       ProcessCollaborator[]
  governanceInstances GovernanceInstance[]
  publications        Publication[]

  @@index([folderId])
  @@index([createdById])
  @@index([status])
  @@index([category])
  @@map("processes")
}

model ProcessVersion {
  id           String   @id @default(uuid())
  processId    String
  version      Int
  bpmnXml      String
  svgThumbnail String?
  changelog    String?
  createdById  String
  createdAt    DateTime @default(now())

  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([createdById])
  @@map("process_versions")
}

model Folder {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent    Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]  @relation("FolderHierarchy")
  processes Process[]
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([createdById])
  @@map("folders")
}

// ─── Collaboration ───────────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  content   String
  processId String
  userId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  process Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([processId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model ProcessCollaborator {
  id        String   @id @default(uuid())
  processId String
  userId    String
  role      String   @default("VIEWER") // VIEWER, EDITOR, REVIEWER, OWNER
  addedAt   DateTime @default(now())

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([userId])
  @@map("process_collaborators")
}

// ─── Publication & Feedback ──────────────────────────────────────────────────

model Publication {
  id            String    @id @default(uuid())
  processId     String
  title         String
  description   String?
  isPublic      Boolean   @default(false)
  publishedById String
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime?
  viewCount     Int       @default(0)

  process     Process               @relation(fields: [processId], references: [id], onDelete: Cascade)
  publishedBy User                  @relation(fields: [publishedById], references: [id], onDelete: Cascade)
  feedbacks   PublicationFeedback[]

  @@index([processId])
  @@index([publishedById])
  @@map("publications")
}

model PublicationFeedback {
  id            String   @id @default(uuid())
  publicationId String
  userId        String
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([publicationId])
  @@index([userId])
  @@map("publication_feedbacks")
}

// ─── Governance ──────────────────────────────────────────────────────────────

model GovernanceWorkflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  steps       String? // JSON string
  triggerType String   @default("MANUAL") // MANUAL, ON_PUBLISH, ON_CHANGE
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  instances GovernanceInstance[]

  @@index([createdById])
  @@map("governance_workflows")
}

model GovernanceInstance {
  id            String    @id @default(uuid())
  workflowId    String
  processId     String
  status        String    @default("PENDING") // PENDING, IN_PROGRESS, APPROVED, REJECTED, CANCELLED
  currentStep   Int       @default(0)
  initiatedById String
  initiatedAt   DateTime  @default(now())
  completedAt   DateTime?
  data          String? // JSON string

  workflow    GovernanceWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  process     Process              @relation(fields: [processId], references: [id], onDelete: Cascade)
  initiatedBy User                 @relation(fields: [initiatedById], references: [id], onDelete: Cascade)
  approvals   GovernanceApproval[]

  @@index([workflowId])
  @@index([processId])
  @@index([initiatedById])
  @@index([status])
  @@map("governance_instances")
}

model GovernanceApproval {
  id         String    @id @default(uuid())
  instanceId String
  stepIndex  Int
  approverId String
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  instance GovernanceInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  approver User               @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([approverId])
  @@map("governance_approvals")
}

// ─── Notifications & Audit ───────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    String? // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Dictionary ──────────────────────────────────────────────────────────────

model DictionaryEntry {
  id          String   @id @default(uuid())
  term        String   @unique
  definition  String
  category    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([category])
  @@map("dictionary_entries")
}
